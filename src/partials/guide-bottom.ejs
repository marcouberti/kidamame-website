<%
  const currentGuide = (locals.guides || []).find(g => g.slug === locals.currentSlug) || {};
  const relatedList = (locals.relatedSlugs || [])
    .map(slug => (locals.guides || []).find(g => g.slug === slug))
    .filter(Boolean);
%>

<% if (relatedList.length > 0) { %>
<!-- RELATED GUIDES -->
<div class="reveal" style="margin-top: 4rem;">
  <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
    <h3 style="font-family: var(--font-display); font-size: 1.8rem; color: var(--ink); margin: 0;">More Parenting Guides</h3>
    <a href="/guides/" style="font-size: 0.95rem; font-weight: 800; color: var(--blue);">View all guides &rarr;</a>
  </div>
  <div class="guides-grid" style="margin-top: 1.2rem;">
    <% relatedList.forEach(function(item) { %>
      <a href="/guides/<%= item.slug %>/" class="guide-card">
        <div class="guide-card-top" style="margin-bottom: 0.8rem;">
          <div class="guide-card-icon"><i class="<%= item.icon %>"></i></div>
        </div>
        <h3><%= item.shortTitle %></h3>
        <p><%= item.description %></p>
        <span class="guide-card-link">Read guide <i class="fa-solid fa-arrow-right"></i></span>
      </a>
    <% }); %>
  </div>
</div>
<% } %>

<% if (currentGuide.slug) { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.kidamame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Guides",
          "item": "https://www.kidamame.com/guides/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": <%- JSON.stringify(currentGuide.shortTitle) %>,
          "item": "https://www.kidamame.com/guides/<%= currentGuide.slug %>/"
        }
      ]
    },
    {
      "@type": "Article",
      "headline": <%- JSON.stringify(currentGuide.title) %>,
      "description": <%- JSON.stringify(currentGuide.description) %>,
      "author": {
        "@type": "Organization",
        "name": "Kidamame",
        "url": "https://www.kidamame.com/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Kidamame",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.kidamame.com/images/weblogo.webp"
        }
      },
      "mainEntityOfPage": "https://www.kidamame.com/guides/<%= currentGuide.slug %>/",
      "image": "https://www.kidamame.com/images/hero_image.webp"
    }
  ]
}
</script>
<% } %>
</div>
